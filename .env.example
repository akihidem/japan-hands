# Ledger storage (Vercel KV / Upstash). If unset, a local JSON file is used.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Operator email notifications via Resend
HFA_NOTIFY_ENABLED=0
RESEND_API_KEY=
HFA_NOTIFY_TO=operator@example.com
HFA_NOTIFY_FROM=

# USD quotes: fixed JPY-per-USD rate stated at quote time (default 150)
HFA_USDJPY_RATE=150

# Local-only: override the fallback ledger file path
# HFA_STORE_FILE=./data/store.json

# Stripe (optional; enables checkout links + the payment gate)
STRIPE_SECRET_KEY=
# Webhook signing secret for POST /api/stripe/webhook (events: checkout.session.completed).
# Register the endpoint https://japan-hands.vercel.app/api/stripe/webhook in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# Rate limits per IP per hour (defaults shown)
# HFA_RL_QUOTE_PER_HOUR=20
# HFA_RL_WRITE_PER_HOUR=60
# HFA_RL_MCP_PER_HOUR=300
